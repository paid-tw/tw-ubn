{
  "name": "@paid-tw/ubn",
  "version": "0.1.1",
  "description": "Taiwan business registry (統一編號) open dataset + a tiny checkout VAT-to-title lookup client",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paid-tw/tw-ubn.git",
    "directory": "client"
  },
  "homepage": "https://github.com/paid-tw/tw-ubn#readme",
  "bugs": "https://github.com/paid-tw/tw-ubn/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "taiwan",
    "統一編號",
    "ubn",
    "ban",
    "vat",
    "einvoice",
    "open-data"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
