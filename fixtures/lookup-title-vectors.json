    {
      "label": "200 with a whitespace-only name",
      "status": 200,
      "body": "{\"found\":true,\"ban\":\"22099131\",\"name\":\" \u3000\"}",
      "expect": null
    },
    {
      "label": "200 with a BMP PUA name (#10)",
      "status": 200,
      "body": "{\"found\":true,\"ban\":\"22099131\",\"name\":\"某某\uf585商行\"}",
      "expect": null
    },
    {
      "label": "200 with a plane-15 PUA name (#10)",
      "status": 200,
      "body": "{\"found\":true,\"ban\":\"22099131\",\"name\":\"台北\udba8\udffe行\"}",
      "expect": null
    },
    {
      "label": "200 with the server flag nameHasPrivateUse",
      "status": 200,
      "body": "{\"found\":true,\"ban\":\"22099131\",\"name\":\"某某商行\",\"nameHasPrivateUse\":true}",
      "expect": null
    }
  ]
}
